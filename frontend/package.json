{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "licenses": "node tools/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run licenses && npm run traceability",
    "tokens": "node tokens/build.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "prestorybook": "npm run tokens",
    "prebuild-storybook": "npm run tokens",
    "budget": "node tools/check-budget.mjs",
    "traceability": "node tools/check-traceability.mjs",
    "review:fixtures": "node tools/screen-lint.mjs --fixtures",
    "plugin:build": "node tools/build-plugin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "2.11.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22"
  }
}
